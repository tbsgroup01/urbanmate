NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
CLIENT_ORIGIN=http://localhost:5173
DEFAULT_CURRENCY=USD
LOG_LEVEL=info

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=urbanmate
DB_USER=root
DB_PASSWORD=
DB_POOL_MAX=10
DB_POOL_MIN=0

JWT_SECRET=replace-this-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=15m
JWT_ISSUER=urbanmate-api
JWT_AUDIENCE=urbanmate-clients
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_SALT_ROUNDS=12
PASSWORD_RESET_URL=http://localhost:5173/reset-password
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional private S3-compatible bucket for provider identity documents.
DOCUMENT_STORAGE_BUCKET=
DOCUMENT_STORAGE_REGION=
DOCUMENT_STORAGE_ENDPOINT=
DOCUMENT_STORAGE_ACCESS_KEY_ID=
DOCUMENT_STORAGE_SECRET_ACCESS_KEY=
DOCUMENT_STORAGE_FORCE_PATH_STYLE=false

# Optional bootstrap. Set both only for the first admin seeder run.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=Urbanmate Admin
